#!/bin/sh
# Writes a valid empty pcap header, then waits for SIGINT like the real tool.
out=""
while [ $# -gt 0 ]; do [ "$1" = "-w" ] && { out="$2"; shift; }; shift; done
printf "\324\303\262\241\002\000\004\000\000\000\000\000\000\000\000\000\377\377\000\000\001\000\000\000" > "$out"
trap "exit 0" INT TERM
while true; do sleep 0.2; done
